# Runtime data: run history, reports, snapshots, server profiles (DPAPI-encrypted passwords)
data/
reports/
node_modules/

# Engine test output (inspect after a failing run)
test/.out/

# Impeccable: runtime folders under .impeccable/ ignore themselves, so PRODUCT.md, DESIGN.md and
# .impeccable/config.json can be committed. The engine binary is downloaded per machine (21 MB).
.impeccable/config.local.json
.claude/skills/impeccable/scripts/bin/
